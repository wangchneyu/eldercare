{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eldercare.local/contracts/iot/c05-elder-sos-event-v1.schema.json",
  "title": "C05 elder-sos-event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "traceId", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "pattern": "^[0-9]+$" },
    "eventType": { "enum": ["SOS_TRIGGERED", "FALL_DETECTED"] },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceId": { "type": "string", "minLength": 1 },
    "producer": { "const": "service-iot@1.0.0" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMessageId", "deviceId", "deviceType", "elderId"],
      "properties": {
        "sourceMessageId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "deviceType": { "type": "string", "minLength": 1 },
        "elderId": { "type": ["string", "null"] },
        "bindingId": { "type": ["string", "null"] },
        "parkId": { "type": ["string", "null"] },
        "buildingId": { "type": ["string", "null"] },
        "roomId": { "type": ["string", "null"] },
        "roomNo": { "type": ["string", "null"] },
        "locationBindingId": { "type": ["string", "null"] },
        "location": { "type": ["object", "null"], "additionalProperties": true },
        "triggerType": { "type": ["string", "null"] },
        "batteryLevel": { "type": ["integer", "null"] }
      }
    }
  },
  "x-rocketmq": {
    "topic": "elder-sos-event",
    "tagByEventType": {
      "SOS_TRIGGERED": "SOS",
      "FALL_DETECTED": "FALL"
    }
  }
}
