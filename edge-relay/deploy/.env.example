# Copy to deploy/.env before overriding the Docker Compose defaults.
# Keep MQTT credentials in a local secret store; do not commit deploy/.env.
EDGE_SITE_ID=park-site-01

EDGE_LOCAL_MQTT_BROKER_URL=tcp://edge-emqx:1883
EDGE_LOCAL_MQTT_CLIENT_ID=edge-relay-local
EDGE_LOCAL_MQTT_AUTO_CONNECT=true
EDGE_LOCAL_MQTT_USERNAME=
EDGE_LOCAL_MQTT_PASSWORD=

# The bundled cloud-emqx is a local recovery-test fixture only.
# Replace this with the approved cloud endpoint in a real environment.
EDGE_CLOUD_MQTT_BROKER_URL=tcp://cloud-emqx:1883
EDGE_CLOUD_MQTT_CLIENT_ID=edge-relay-cloud
EDGE_CLOUD_MQTT_AUTO_CONNECT=true
EDGE_CLOUD_MQTT_USERNAME=
EDGE_CLOUD_MQTT_PASSWORD=

EDGE_CAREGIVER_TERMINAL_IDS=caregiver-01
EDGE_SQLITE_MAX_BYTES=1073741824
EDGE_SQLITE_P0_RESERVE_BYTES=268435456
EDGE_SQLITE_RETENTION_HOURS=24
EDGE_SQLITE_CLEANUP_BATCH_SIZE=500
EDGE_SQLITE_CLEANUP_INTERVAL_MS=300000
EDGE_FORWARD_BATCH_SIZE=100
EDGE_FORWARD_LEASE_SECONDS=60
EDGE_FORWARD_INTERVAL_MS=2000
EDGE_NOTIFY_INTERVAL_MS=10000
EDGE_NOTIFY_BATCH_SIZE=200
